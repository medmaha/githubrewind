{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "githubrewind",
    "main": "vinext/server/fetch-handler",
    "compatibility_date": "2026-10-13",
    "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
    // "build": {
    //     "command": "pnpm build:vinext",
    //     "cwd": "."
    // },
    "ai": {
        "binding": "AI",
    },
    "ratelimits": [
        {
            "name": "REWIND_RATE_LIMITER",
            "namespace_id": "1002",
            "simple": {
                "limit": 5,
                "period": 60,
            },
        },
        {
            "name": "INSIGHTS_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 2,
                "period": 60,
            },
        },
    ],
    "assets": {
        "binding": "ASSETS",
    },
    "images": {
        "binding": "IMAGES",
    },
    "secrets": {
        "required": [
            //
            "ARCJET_KEY",
            "INTERNAL_GITHUB_API_TOKEN",
        ],
    },
    "workers_dev": true,
    "observability": {
        "enabled": false,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
        },
    },
}
